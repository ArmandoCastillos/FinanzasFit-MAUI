<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MauiApp1.Models"
             x:Class="MauiApp1.Views.GastosPage"
             Title="Gastos">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="15" RowSpacing="10">

        <Label x:Name="lblTotal" FontSize="18" FontAttributes="Bold" />

        <SearchBar Grid.Row="1" x:Name="buscador" Placeholder="Buscar por descripción o categoría"
                   TextChanged="OnBuscarTextChanged" />

        <!-- Lista de gastos: al tocar uno se abre para editar -->
        <CollectionView Grid.Row="2" x:Name="listaGastos" SelectionMode="Single"
                        SelectionChanged="OnGastoSeleccionado">
            <CollectionView.EmptyView>
                <Label Text="No hay gastos registrados" HorizontalOptions="Center" Margin="20" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Gasto">
                    <Border Margin="0,4" Padding="12" StrokeShape="RoundRectangle 8">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Text="{Binding Descripcion}" FontAttributes="Bold" />
                            <HorizontalStackLayout Grid.Row="1" Spacing="10">
                                <Label Text="{Binding Categoria}" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}"
                                       FontSize="12" TextColor="Gray" />
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Grid.RowSpan="2" VerticalOptions="Center"
                                   Text="{Binding Monto, StringFormat='-${0:N2}'}"
                                   TextColor="#C62828" FontAttributes="Bold" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="3" x:Name="btnAgregar" Text="+ Agregar gasto" Clicked="OnAgregarClicked" />
    </Grid>
</ContentPage>
